extends layout

block content
  .w3-card-4
    header.w3-container.w3-teal
      h1 Lista de Exames Médicos Desportivos
    
    a.w3-btn.w3-yellow.w3-margin-top(href="/emd/stats") Estatísticas
    a.w3-btn.w3-orange.w3-margin-top(href="/emd?order=asc") Ord. Crescente 
    a.w3-btn.w3-blue.w3-margin-top(href="/emd?order=desc") Ord. Decrescente

    a.w3-btn.w3-green.w3-margin-top.w3-right(href="/emd/registo") Novo Registo
    
    .w3-container
      table.w3-table-all.w3-margin-top
        tr
          th Nome
          th Data
          th Modalidade
          th Resultado
        each e in list
          tr.w3-hover-dark-grey(
            onclick=`window.location='/emd/${e.id}'`
            style="cursor:pointer"
          )
            td= e.nome.primeiro + " " + e.nome.último
            td= e.dataEMD
            td= e.modalidade
            td= (e.resultado ? "Aprovado" : "Reprovado")
              
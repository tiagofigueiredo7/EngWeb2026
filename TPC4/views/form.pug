extends layout

block content
  .w3-card-4
    header.w3-container.w3-purple
      h2= e ? "Editar Registo" : "Novo Registo"
    
    form.w3-container.w3-padding-16(method="POST" action=e ? `/emd/${e.id}` : "/emd")
      fieldset
        legend Registo
        if e
          input(type="hidden" name="id" value=e.id)
     
        label Data
        input.w3-input.w3-round(type="text" name="dataEMD" value=e ? e.dataEMD : "")
        
        label Primeiro Nome
        input.w3-input.w3-round(type="text" name="nome.primeiro" value=e ? e.nome.primeiro : "")

        label Último Nome
        input.w3-input.w3-round(type="text" name="nome.último" value=e ? e.nome.último : "")
        
        label Idade
        input.w3-input.w3-round(type="text" name="idade" value=e ? e.idade : "")
        
        label Género
        input.w3-input.w3-round(type="text" name="género" value=e ? e.género : "")

        label Morada
        input.w3-input.w3-round(type="text" name="morada" value=e ? e.morada : "")

        label Modalidade
        input.w3-input.w3-round(type="text" name="modalidade" value=e ? e.modalidade : "")

        label Clube
        input.w3-input.w3-round(type="text" name="clube" value=e ? e.clube : "")

        label Email
        input.w3-input.w3-round(type="text" name="email" value=e ? e.email : "")

        label Federado
        input.w3-input.w3-round(type="text" name="federado" value=e ? (e.federado ? "Sim" : "Não") : "")

        label Resultado
        input.w3-input.w3-round(type="text" name="resultado" value=e ? (e.resultado ? "Aprovado" : "Reprovado") : "")
        
        button.w3-btn.w3-purple.w3-margin-top(type="submit")= e ? "Atualizar" : "Inserir"
        a.w3-btn.w3-grey.w3-margin-top.w3-margin-left(href="/") Cancelar
extends layout

block content
  .w3-card-4
    header.w3-container.w3-teal
      h1 Lista de Géneros
    
    a.w3-btn.w3-grey.w3-margin.w3-border.w3-border-black(href="/") Página Inicial


    .w3-container
      table.w3-table-all.w3-margin-top
        tr
          th Nome
          th No. Filmes

        each g in list
          tr.w3-hover-dark-grey(
            onclick=`window.location='/generos/${g.id}'`
            style="cursor:pointer"
            )
            td= g.name
            td= g.films.length


    a.w3-btn.w3-grey.w3-margin.w3-border.w3-border-black(href="/") Voltar
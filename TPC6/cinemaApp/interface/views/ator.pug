extends layout

block content
  .w3-card-4
    header.w3-container.w3-teal
      h1 #{a.name}

    .w3-container
      table.w3-table-all.w3-margin-top
        tr
          th Filmes feitos

        each f in a.films
          tr.w3-hover-dark-grey(
            onclick=`window.location='/filmes/${f.id}'`
            style="cursor:pointer"
            )
            td= f.title
          
    a.w3-btn.w3-grey.w3-margin.w3-border.w3-border-black(href="/") Voltar
